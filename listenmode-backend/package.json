{
  "name": "listenmode-backend",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "typecheck": "bunx tsc --noEmit",
    "format": "bunx prettier -w .",
    "test": "vitest --run tests/**/*.test.ts src/**/*.test.ts",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage tests/**/*.test.ts src/**/*.test.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.66",
    "@cloudflare/workers-types": "^4.20240821.0",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "3.2.4",
    "typescript": "^5.5.4",
    "vitest": "^3.2.4",
    "wrangler": "^3.77.0"
  },
  "dependencies": {
    "hono": "^4.5.7",
    "@tsndr/cloudflare-worker-jwt": "^3.0.2",
    "zod": "^3.23.8",
    "@hono/cookie": "^4.5.7"
  }
}
